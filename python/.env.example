# ============================================================
# Konfigurasi bridge — SEMUA setelan LLM di .env ini
# (env override config.yaml; jangan commit ke git)
# Copy file ini menjadi .env lalu isi.
# ============================================================

# --- Wajib diisi ---

# API key provider OpenAI-compatible (DeepSeek / 9router / dll)
LLM_API_KEY=sk-your-key-here

# Base URL endpoint OpenAI-compatible (wajib berakhiran /v1)
LLM_BASE_URL=https://<provider-router>/v1

# --- Opsional (bila dikosongkan, pakai default dari config.yaml) ---

# Nama model (lihat daftar via GET /v1/models)
# LLM_MODEL=ocGO/deepseek-v4-flash

# Suhu sampling LLM (0.0-2.0, makin rendah makin deterministik)
# LLM_TEMPERATURE=0.2

# Maksimal token respons (reasoning model butuh budget besar)
# LLM_MAX_TOKENS=4096

# Timeout per panggilan LLM (detik)
# LLM_TIMEOUT_S=15

# Pakai response_format json_object (true/false)
# LLM_JSON_MODE=true

# Jumlah retry saat panggilan gagal
# LLM_RETRIES=2

# N gagal berturut-turut sebelum pindah ke engine deterministik
# LLM_FALLBACK_AFTER_FAILURES=3

# Confidence minimum agar keputusan OPEN diterima
# LLM_MIN_CONFIDENCE=0.55

# --- Remote bridge Linux VPS via Tailscale ---
# BRIDGE_HOST=0.0.0.0
# BRIDGE_PORT=8080
# BRIDGE_REQUIRE_TOKEN=true
# BRIDGE_TOKEN=generate-random-long-token
